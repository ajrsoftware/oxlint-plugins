{
    "name": "@ajrsoftware/oxlint-plugin-sort-imports",
    "version": "1.0.0",
    "description": "Groups and orders the leading import block. Auto-fixable.",
    "keywords": [
        "imports",
        "oxlint",
        "oxlint-plugin",
        "sort"
    ],
    "license": "MIT",
    "author": "@ajrsoftware",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ajrsoftware/oxlint-plugins.git",
        "directory": "plugins/sort-imports"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "exports": "./dist/index.mjs",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --project tsconfig.json",
        "prepublishOnly": "pnpm build"
    },
    "devDependencies": {
        "@ajrsoftware/oxlint-utils": "workspace:*",
        "oxlint": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "oxlint": "^1.87.0"
    }
}
